# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Administrator authentication
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
ADMIN_SECRET=your-admin-session-secret

# Signs short-lived quote, shipping, contact, and notification state
CHECKOUT_SIGNING_SECRET=your-independent-random-signing-secret

# Payments and shipping
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
SHIPPO_API_KEY=your-shippo-api-key
SHIPPO_WEBHOOK_TOKEN=your-shippo-webhook-token
SHIP_FROM_NAME=your-shipping-name
SHIP_FROM_STREET=your-shipping-street
SHIP_FROM_CITY=your-shipping-city
SHIP_FROM_STATE=your-shipping-state
SHIP_FROM_ZIP=your-shipping-postal-code

# Email and scheduled jobs
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=notifications@example.com
REPORT_EMAIL=reports@example.com
CRON_SECRET=your-cron-secret

# Slicer worker and local infrastructure
SLICER_URL=http://your-slicer-host
SLICER_WORKER_URL=http://your-slicer-worker
WORKER_SECRET=your-worker-secret
TRUENAS_URL=http://your-truenas-host
TRUENAS_API_KEY=your-truenas-api-key
GOVEE_API_KEY=your-govee-api-key
SHELLY_IP=your-shelly-device-address
MOONRAKER_URL=http://your-primary-moonraker-host
MOONRAKER_URL_2=http://your-secondary-moonraker-host

# Slicer service configuration
PORT=3001
ORCA_BIN=/path/to/orca-slicer
ORCA_RESOURCES=/path/to/orca-resources
FILES_ROOT=/path/to/files
ELECTRICITY_RATE=0.00
